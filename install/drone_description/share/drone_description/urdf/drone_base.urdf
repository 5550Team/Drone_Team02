<?xml version="1.0"?>
<robot name="quadrotor">

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.3 0.3 0.05"/></geometry>
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
    <collision><geometry><box size="0.3 0.3 0.05"/></geometry></collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.02" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Propeller 1~4 -->
  <link name="propeller_1">
    <visual><geometry><cylinder radius="0.05" length="0.01"/></geometry><material name="red"><color rgba="1 0 0 1"/></material></visual>
    <collision><geometry><cylinder radius="0.05" length="0.01"/></geometry></collision>
    <inertial><mass value="0.01"/><origin xyz="0 0 0"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="propeller_2">
    <visual><geometry><cylinder radius="0.05" length="0.01"/></geometry><material name="green"><color rgba="0 1 0 1"/></material></visual>
    <collision><geometry><cylinder radius="0.05" length="0.01"/></geometry></collision>
    <inertial><mass value="0.01"/><origin xyz="0 0 0"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="propeller_3">
    <visual><geometry><cylinder radius="0.05" length="0.01"/></geometry><material name="yellow"><color rgba="1 1 0 1"/></material></visual>
    <collision><geometry><cylinder radius="0.05" length="0.01"/></geometry></collision>
    <inertial><mass value="0.01"/><origin xyz="0 0 0"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="propeller_4">
    <visual><geometry><cylinder radius="0.05" length="0.01"/></geometry><material name="purple"><color rgba="1 0 1 1"/></material></visual>
    <collision><geometry><cylinder radius="0.05" length="0.01"/></geometry></collision>
    <inertial><mass value="0.01"/><origin xyz="0 0 0"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- LIDAR -->
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.04" length="0.06"/></geometry><material name="black"><color rgba="0 0 0 1"/></material></visual>
    <collision><geometry><cylinder radius="0.04" length="0.06"/></geometry></collision>
    <inertial><mass value="0.05"/><origin xyz="0 0 0"/><inertia ixx="0.0002" iyy="0.0002" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>



  <!-- 关节 -->
  <joint name="base_to_propeller_1" type="fixed"><parent link="base_link"/><child link="propeller_1"/><origin xyz="0.15 0.15 0"/><axis xyz="0 0 1"/></joint>
  <joint name="base_to_propeller_2" type="fixed"><parent link="base_link"/><child link="propeller_2"/><origin xyz="-0.15 0.15 0"/><axis xyz="0 0 1"/></joint>
  <joint name="base_to_propeller_3" type="fixed"><parent link="base_link"/><child link="propeller_3"/><origin xyz="-0.15 -0.15 0"/><axis xyz="0 0 1"/></joint>
  <joint name="base_to_propeller_4" type="fixed"><parent link="base_link"/><child link="propeller_4"/><origin xyz="0.15 -0.15 0"/><axis xyz="0 0 1"/></joint>

  <!-- Lidar +Z -->
  <joint name="base_to_lidar" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0 0 0.055"/></joint>
  
  <!-- ===================== Gazebo：LIDAR ===================== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="ray">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <pose>0 0 0 0 0 0</pose>

      <!--  270 ，1080  -->
      <ray>
        <scan>
          <horizontal>
            <samples>1080</samples>
            <resolution>1</resolution>
            <min_angle>-2.35619</min_angle>  <!-- -135° -->
            <max_angle> 2.35619</max_angle>  <!-- +135° -->
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>

      <!-- ROS2 pub LaserScan（/lidar/scan） -->
      <plugin name="lidar_ros" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/lidar</namespace>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <frame_name>lidar_link</frame_name>
        <output_type>sensor_msgs/LaserScan</output_type>
        <topic>scan</topic>
      </plugin>
    </sensor>
  </gazebo>

  

<gazebo>
  <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
    <ros>
      <namespace>/</namespace>
    </ros>
    <command_topic>/cmd_vel</command_topic>
    <odometry_frame>odom</odometry_frame>
    <odometry_topic>odom</odometry_topic>
    <robot_base_frame>base_link</robot_base_frame>
    <publish_odom>true</publish_odom>
    <update_rate>50</update_rate>
  </plugin>
</gazebo>

</robot>

